# Manas Environment Configuration
# Copy to .env.local and fill in values

# AI Provider: 'mock' (default, deterministic) or 'qwen' (Alibaba Cloud)
MANAS_AI_PROVIDER=mock

# Alibaba Qwen API Key (required only when MANAS_AI_PROVIDER=qwen)
ALIBABA_QWEN_API_KEY=

# Qwen model name
ALIBABA_QWEN_MODEL=qwen-plus

# Request timeout in milliseconds
ALIBABA_QWEN_TIMEOUT_MS=10000

# Supabase (only required when MANAS_PERSISTENCE=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Persistence mode: 'memory' (default, public deployment) | 'supabase' (controlled demo)
MANAS_PERSISTENCE=memory

# Demo mode: 'true' enables seeded demonstration data in memory mode
MANAS_DEMO_MODE=true

# Supabase test mode: 'true' enables real RLS tests against a dedicated test project
MANAS_SUPABASE_TEST_ENABLED=false
SUPABASE_TEST_USER_EMAIL=
SUPABASE_TEST_USER_PASSWORD=
