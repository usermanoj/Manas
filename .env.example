# Manas Environment Configuration
# Copy to .env.local and fill in values

# AI Provider: 'mock' (default, deterministic) or 'qwen' (Alibaba Cloud)
MANAS_AI_PROVIDER=mock

# Alibaba Qwen API Key (required only when MANAS_AI_PROVIDER=qwen)
ALIBABA_QWEN_API_KEY=

# Qwen model name
ALIBABA_QWEN_MODEL=qwen-plus

# Request timeout in milliseconds
ALIBABA_QWEN_TIMEOUT_MS=10000
